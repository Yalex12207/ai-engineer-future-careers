  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --max-old-space-size=768 --max-semi-space-size=4 node_modules/typescript/bin/tsc -b && node --max-old-space-size=768 --max-semi-space-size=4 node_modules/vite/bin/vite.js build",
