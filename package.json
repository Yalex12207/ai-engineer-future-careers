    "prepare:submission": "node scripts/prepare-submission.mjs",
    "capture:qa": "node scripts/capture-qa.mjs",
    "export:video": "node scripts/export-video.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
